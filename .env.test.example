# Environment variables for E2E testing

# Test User Credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!

# Application URL
BASE_URL=http://localhost:5173

# Clerk Test Keys (if needed for test environment)
